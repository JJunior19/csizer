{
  "name": "csizer",
  "version": "0.0.0-dev",
  "description": "Evidence-based container workload tracking and ECS Fargate sizing recommendations (installs the csizer native binary)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJunior19/csizer.git"
  },
  "bin": {
    "csizer": "bin/csizer.js"
  },
